# Application
APP_ENV=development

# Traefik
# Published host port for Traefik. Traefik is the only public entrypoint in compose.
HTTP_PORT=8080

# Frontend
# Public browser-visible API base path. This is not a secret.
PUBLIC_API_BASE_URL=/api

# Current Course Service
BACKEND_INTERNAL_PORT=3000

# Current Course Service database. These values initialize the course-postgres
# container and are passed to the course-service as DATABASE_* variables.
COURSE_DB_NAME=ewill_courses
COURSE_DB_USER=ewill_courses
COURSE_DB_PASSWORD=change-me
DATABASE_SSL=false
DATABASE_MIGRATIONS_RUN=true

# Local persistent file storage for course learning materials.
COURSE_MATERIAL_MAX_FILE_SIZE_BYTES=52428800

# Development/test/demo-only seed data for the learning-process demo.
COURSE_DEMO_SEED_DISABLED=false

# Optional future Group/Task Service example.
# These values are not used by the current compose.yaml.
GROUP_TASK_DB_NAME=group_tasks
GROUP_TASK_DB_USER=group_tasks
GROUP_TASK_DB_PASSWORD=change-me
GROUP_TASK_SERVICE_URL=http://group-task-service:8080
